# PDO DSN for PostgreSQL (default: pgsql:host=127.0.0.1;dbname=localizer)
PG_DSN=
# PostgreSQL user (default: localizer)
PG_USER=
# PostgreSQL password (default: empty)
PG_PASS=
# OpenAI-compatible chat completions endpoint (default: http://127.0.0.1:11434/v1/chat/completions, a local Ollama)
LLM_ENDPOINT=
# Model used for localization (default: qwen2.5:14b-instruct)
LLM_MODEL=
# API key for the LLM endpoint (leave empty for a local Ollama)
LLM_KEY=
