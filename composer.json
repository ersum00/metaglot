{
    "name": "ersum00/metaglot",
    "description": "Search-aware localization of video titles and descriptions into multiple languages. Uses the YouTube Data API v3.",
    "type": "project",
    "license": "MIT",
    "keywords": ["localization", "seo", "metadata", "cli"],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Metaglot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Metaglot\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/metaglot"
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse",
        "test": "phpunit"
    }
}
